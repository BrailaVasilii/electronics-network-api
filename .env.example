# Django settings
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# Database settings (Docker)
DB_NAME=electronics_network_db
DB_USER=postgres
DB_PASSWORD=postgres_pass
DB_HOST=db
DB_PORT=5432

# Database URL (alternative format for Docker)
DATABASE_URL=postgresql://postgres:postgres_pass@db:5432/electronics_network_db

# Redis settings
REDIS_URL=redis://redis:6379/0

# CORS settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Docker Superuser (optional - for automatic superuser creation)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123

# Production settings (uncomment for production)
# DEBUG=False
# ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# SECRET_KEY=your-production-secret-key-here